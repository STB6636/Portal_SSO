# =============================================================================
# Portal SSO v2.4.0 (STB-APP) — Environment Variables Template
# คัดลอกไฟล์นี้เป็น .env.local สำหรับรันในเครื่อง (ห้าม commit .env.local ขึ้น Git)
# =============================================================================

# Supabase Project URL & Publishable Key (ตั้งค่าใน .env.local หรือ Cloudflare/GitHub Secrets)
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-publishable-key>

# Optional Legacy Alias (fallback หากไม่ได้ระบุ VITE_SUPABASE_PUBLISHABLE_KEY)
# VITE_SUPABASE_ANON_KEY=

# Supabase Schema สำหรับ Portal SSO Core (มติ Q3: ใช้ public, เว็บแอปย่อยแยก Schema ใหม่ในโปรเจกต์เดียวกัน)
VITE_SUPABASE_SCHEMA=public

# Dual-Hosting Router Mode:
#   Cloudflare Pages -> VITE_ROUTER_MODE=browser, VITE_BASE_PATH=/
#   GitHub Pages     -> VITE_ROUTER_MODE=hash,    VITE_BASE_PATH=/Portal_SSO/
VITE_ROUTER_MODE=hash
VITE_BASE_PATH=./

# -----------------------------------------------------------------------------
# Local Migration / CLI Only (ห้ามตั้งชื่อขึ้นต้นด้วย VITE_ และห้ามใส่ใน Frontend)
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres:<password>@db.<your-project-ref>.supabase.co:5432/postgres
